# Neon: connection string (Neon > Connect > "Pooled connection")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Meta / Instagram (App Dashboard > Instagram > API setup with Instagram login)
META_APP_SECRET=chave_secreta_do_app_instagram
META_VERIFY_TOKEN=qualquer_frase_secreta_que_voce_inventar
IG_ACCESS_TOKEN=token_de_longa_duracao_gerado_no_painel
GRAPH_API_VERSION=v24.0

# Painel
ADMIN_USER=marcelle
ADMIN_PASSWORD=troque_esta_senha

# Vercel Cron (gere um valor aleatório longo)
CRON_SECRET=valor_aleatorio_longo

# Horas que o bot fica em silêncio depois que você responde manualmente no direct
HUMAN_PAUSE_HOURS=24
